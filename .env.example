# Shared
POSTGRES_ADMIN_USER=copilot_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
AGENT_STATE_PASSWORD=change-me-agent-state
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token

# Agent service
# Set an API key and model supplied by your OpenAI-compatible provider.
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_MODEL=replace-with-provider-model
OPENAI_BASE_URL=
# For a third-party OpenAI-compatible endpoint, set OPENAI_BASE_URL as well.
BUSINESS_SERVICE_URL=http://business-service:8080
AGENT_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080
BUSINESS_ALLOWED_ORIGINS=http://localhost:8000
AUDIT_FAIL_CLOSED=true
RETRIEVAL_MODE=hybrid
GROUNDING_V2_MODE=shadow
CONTEXT_HARNESS_V2_MODE=shadow
EVIDENCE_DRAWER_MODE=shadow
OTEL_MODE=shadow
CLARIFICATION_RESUME_MODE=shadow
ROLLOUT_POLICY_MODE=shadow
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SUCCESS_SAMPLE_RATE=0.05
TRACE_RETENTION_DAYS=30
METRIC_RETENTION_DAYS=90
CONTEXT_TOKEN_BUDGET=8192
CLARIFICATION_TTL_SECONDS=900
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RETRIEVAL_TOP_K=8
HARNESS_MAX_TOOL_CALLS=8
HARNESS_MAX_RETRIES=2
HARNESS_TIMEOUT_SECONDS=120
MEMORY_TOP_K=5
MEMORY_MAX_PER_USER=500
MEMORY_RETENTION_DAYS=90
CONVERSATION_RETENTION_DAYS=90

# Shared
POSTGRES_ADMIN_USER=copilot_admin
POSTGRES_ADMIN_PASSWORD=change-me-admin
JWT_SECRET=replace-with-at-least-32-random-characters
INTERNAL_SERVICE_TOKEN=replace-with-a-random-service-token

# Agent service
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_BASE_URL=
# 使用本机 MLX OpenAI-compatible 服务时改为：
# OPENAI_API_KEY=local-mlx
# OPENAI_MODEL=default_model
# OPENAI_BASE_URL=http://host.docker.internal:8081/v1
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b
BUSINESS_SERVICE_URL=http://business-service:8080
AGENT_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8080
AUDIT_FAIL_CLOSED=true
RETRIEVAL_MODE=hybrid
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RETRIEVAL_TOP_K=8
